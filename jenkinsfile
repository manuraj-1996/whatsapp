@Library('shared-library') _

pipeline {
    agent any

    parameters {
        string(name: 'AWS', defaultValue: 'ecommerce')
    }

    stages {

        stage('Initialize') {
            steps {
                script {

                    awsEnv(this, [
                        credentialsId: 'aws-creds',
                        region: 'us-east-1',
                        accountId: '772064137213'
                    ])

                    // everything is now in env automatically
                }
            }
        }

        stage('Checkout') {
            steps {
                gitCheckout()
            }
        }

        stage('Build and Test (Maven)') {
            steps {
                mvnBuild()
            }
        }

        stage('Build Docker image') {
            steps {
                dockerBuild(imageName: env.ECR_REPO)
            }
        }

        stage('ECR login') {
            steps {
                ecrLogin([
                    credentialsId: 'aws-creds',
                    region: env.AWS_REGION,
                    accountId: env.ACCOUNT_ID
                ])
            }
        }

        stage('Tag Docker Image') {
            steps {
                dockerTag(
                    imageName: env.ECR_REPO,
                    ecrURL: env.ECR_URL,
                    tag: env.APP_VERSION
                )
            }
        }

        stage('Push to ECR') {
            steps {
                dockerPush(
                    ecrUrl: env.ECR_URL,
                    tag: env.APP_VERSION
                )
            }
        }
    }

    post {
        success {
            echo 'pipeline executed successfully!'
        }
        failure {
            echo 'pipeline failed, check logs for details'
        }
        always {
            cleanWs()
        }
    }
}
